# Copy to .env.local for local development.
#
# Everything prefixed VITE_ is inlined into the JavaScript bundle at build
# time, which means it is public. Never put a credential in this file.

# Base URL of the counter API, with no trailing slash. Printed by terraform as
# the api_base_url output.
VITE_API_BASE_URL=https://abc123xyz.execute-api.us-east-1.amazonaws.com

# Public URL of the site. Used only by the deploy workflow smoke test.
VITE_SITE_URL=https://d111111abcdef8.cloudfront.net
